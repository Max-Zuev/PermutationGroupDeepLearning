// Data-scaling arm: vo_full_random on a 500k uniform subsample of the full-
// universe train file. Curve: 100k/200k/300k/500k/1000k/1.83M.
[
    {
        name: 'vo_pfx_conv_800k',
        __parents__: ['default'],

        // run metadata (logged to wandb, not read by the code)
        data_format: 'variable_r_union',
        sig_max_r: 16,
        train_orders: '2-64',
        eval_orders: '65-500',
        eval_regime: 'extrapolation',
        embedding_kind: 'random_normmatched',
        train_variant: 'pfx_convmax_800k',

        data_dir: 'pairs_union_subsets',
        train_file: 'train_800000.csv',
        eval_file: 'eval_gt64_masked.csv',
        output_dir: 'varr_pfx_conv_800k',
        wandb_run_name: 'vo_pfx_conv_800k',

        // embedding initialisation
        embedding_path: 'random_normmatched_d576.npy',

        // schedule overrides
        eval_per_samples: 10240,
        tolerance_samples: 512000,
    },
]
